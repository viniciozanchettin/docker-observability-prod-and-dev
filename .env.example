# Copy this file to .env and replace the example passwords before starting.
COMPOSE_PROFILES=production,development,database,observability
PHP_VERSION=8.3

MYSQL_DATABASE=client_app
MYSQL_USER=client_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306

PRODUCTION_PORT=8000
PRODUCTION_DOCUMENT_ROOT=/var/www/html/public
DEVELOPMENT_PORT=8001
DEVELOPMENT_DOCUMENT_ROOT=/var/www/html/public

PHPMYADMIN_PORT=8002
PHPMYADMIN_UPLOAD_LIMIT=64M

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
